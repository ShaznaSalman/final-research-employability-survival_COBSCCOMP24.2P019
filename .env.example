# Copy to .env and adjust if needed.

# Frontend -> API
API_URL=http://127.0.0.1:8000

# Frontend -> separate profile/progress service (optional)
PROFILE_STORE_URL=http://127.0.0.1:8001
PROFILE_STORE_DB=data/profile_store.sqlite3
# Fill these locally to enable phone OTP; never commit .env or share the API key.
SMS_API_ENDPOINT=https://dashboard.smsapi.lk/api/v3/sms/send
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=SMSAPI Demo
SMS_API_AUTH_SCHEME=Bearer

# API: where trained artifacts and the reference database live (defaults shown)
EP_ARTIFACTS_DIR=artifacts
EP_REFERENCE_DB=data/reference/reference.db

# LLM benchmark API mode (optional - only the provider you use)
OPENAI_API_KEY=
LLM_MODEL_OPENAI=
ANTHROPIC_API_KEY=
LLM_MODEL_ANTHROPIC=claude-opus-5-5
GEMINI_API_KEY=
LLM_MODEL_GEMINI=
