# Copy to .env and adjust if needed.

# Frontend -> API
API_URL=http://127.0.0.1:8000

# API: where trained artifacts and the reference database live (defaults shown)
EP_ARTIFACTS_DIR=artifacts
EP_REFERENCE_DB=data/reference/reference.db

# LLM benchmark API mode (optional - only the provider you use)
OPENAI_API_KEY=
LLM_MODEL_OPENAI=
ANTHROPIC_API_KEY=
LLM_MODEL_ANTHROPIC=claude-opus-5-5
GEMINI_API_KEY=
LLM_MODEL_GEMINI=
