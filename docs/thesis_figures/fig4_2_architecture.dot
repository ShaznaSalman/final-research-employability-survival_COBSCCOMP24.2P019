digraph G {
  compound=true; newrank=true; nodesep=0.35; ranksep=0.35; bgcolor="white"; dpi=200;
  node [shape=box, style="rounded,filled", fillcolor="white", color="#888888", fontname="Times New Roman,", fontsize=16, penwidth=1.4, width=3.6];
  edge [color="#555555", penwidth=1.3, arrowsize=0.8];
  subgraph cluster_data { label="Data layer"; labeljust=l; fontname="Times New Roman, Bold"; fontsize=18; style="rounded,filled"; fillcolor="#EDF4FD"; color="#2A78D6"; penwidth=1.6;
    sv [label="Survey responses\n1,175 graduates, 245 employers"]; ads [label="Job advertisements\n324 real entry-level IT ads"]; }
  subgraph cluster_off { label="Offline pipeline (python -m core.run_all)"; labelloc=b; fontname="Times New Roman, Bold"; fontsize=18; style="rounded,filled"; fillcolor="#FDF0E8"; color="#E8703A"; penwidth=1.6;
    cl [label="Cleaning, audit trail and\noutcome (duration, event)"]; sp [label="Fixed split: train 70% /\nvalidation 15% / test 15%"];
    fit [label="7 survival models fitted on train,\ncompared on validation"]; te [label="Selected model evaluated\nonce on the test set"];
    art [label="Artifacts: final model, 200 bootstrap\nmodels, reports and figures"];
    cl -> sp -> fit -> te -> art; }
  subgraph cluster_rt { label="Runtime (stateless; nothing stored)"; labelloc=b; fontname="Times New Roman, Bold"; fontsize=18; style="rounded,filled"; fillcolor="#E8F5EE"; color="#1FA971"; penwidth=1.6;
    user [label="Graduate or final-year student", shape=ellipse, style=filled];
    web [label="Streamlit web application\n4 pages"]; api [label="FastAPI REST service\n13 endpoints, typed validation"];
    core [label="Core library: prediction, explanation,\nwhat-if, suggestions, alignment, chat"];
    db [label="Reference database (SQLite)\naggregated demand, peer groups"];
    user -> web [dir=both]; web -> api [dir=both]; core -> api; db -> core; }
  sv -> cl; ads -> cl; art -> core; art -> db;
  {rank=same; cl; user} {rank=same; sp; web} {rank=same; fit; api} {rank=same; te; core} {rank=same; art; db}
}
