digraph G {
  newrank=true; nodesep=0.35; ranksep=0.32; bgcolor="white"; dpi=200;
  node [shape=box, style="rounded,filled", fillcolor="white", color="#888888", fontname="Times New Roman,", fontsize=15, penwidth=1.4, width=3.4];
  edge [color="#555555", penwidth=1.3, arrowsize=0.8, fontname="Times New Roman,", fontsize=14];
  start [label="Graduate or final-year student\nenters a profile", shape=ellipse, fillcolor="#EDF4FD", color="#2A78D6"];
  check [label="API checks every field\nagainst typed schemas"];
  valid [label="Valid?", shape=diamond, fillcolor="#FDF0E8", color="#E8703A", width=1.6, height=0.9];
  err [label="Clear error message;\nnothing is stored", fillcolor="#FDECEC", color="#C0392B"];
  still [label="Still looking for the\nfirst IT job?", shape=diamond, fillcolor="#FDF0E8", color="#E8703A", width=2.4, height=1.0];
  cond [label="Estimate from graduates who were\nalso still looking at that point"];
  curve [label="Selected AFT model builds the\nsurvival curve S(t) for the profile"];
  boot [label="200 bootstrap models give\nthe uncertainty"];
  rng [label="Inputs inside the range\nseen in training?", shape=diamond, fillcolor="#FDF0E8", color="#E8703A", width=2.6, height=1.0];
  caut [label="Caution shown\nwith the result", fillcolor="#FFF6DD", color="#B97A00"];
  res [label="Most likely time, typical range,\nconfidence label, chance of a job\nby 3, 6, 12 and 24 months"];
  expl [label="Explanation: what is helping\nand what is holding back"];
  wi [label="What-if and suggestions\n(actionable factors, realistic ranges)"];
  mk [label="Market alignment, peers\nand grounded chat"];
  end [label="Results shown;\nnothing is stored", shape=ellipse, fillcolor="#E8F5EE", color="#1FA971"];
  start -> check -> valid;
  valid -> err [label=" no"]; valid -> still [label=" yes"];
  still -> cond [label=" yes"]; still -> curve [label=" no"]; cond -> curve;
  curve -> boot -> rng;
  rng -> caut [label=" no"]; rng -> res [label=" yes"]; caut -> res;
  res -> expl -> wi -> mk -> end;
  {rank=same; valid; err} {rank=same; still; cond} {rank=same; rng; caut}
}
