digraph G {
  newrank=true; nodesep=0.28; ranksep=0.34; bgcolor="white"; dpi=200;
  node [shape=box, style="rounded,filled", fillcolor="white", color="#888888", fontname="Times New Roman,", fontsize=15, penwidth=1.4];
  edge [color="#555555", penwidth=1.3, arrowsize=0.8];
  tr [label="Training set: 620 graduates", fillcolor="#EDF4FD", color="#2A78D6"];
  pre [label="Preprocessing: impute, scale, encode\n(learned on the training set only)"];
  subgraph cluster_m { label="Seven candidate models (four families)"; labelloc=t; fontname="Times New Roman, Bold"; fontsize=16; style="rounded,filled"; fillcolor="#FDF0E8"; color="#E8703A"; penwidth=1.6;
    m1 [label="Cox\nproportional\nhazards\n(linear)", width=1.5]; m2 [label="Elastic Net\nCox\n(regularised)", width=1.5];
    m3 [label="AFT: Weibull,\nLog-Normal,\nLog-Logistic\n(chosen by AIC)", width=1.7]; m4 [label="DeepSurv\n(neural\nnetwork)", width=1.5]; {rank=same; m1; m2; m3; m4} }
  curve [label="Survival curve S(t) for every graduate"];
  val [label="Validation set: 133 graduates\nUno's C, Harrell's C, integrated Brier score, calibration", fillcolor="#EDF4FD", color="#2A78D6"];
  rule [label="Pre-set selection rule (fixed before the analysis)"];
  sel [label="Selected model: AFT Log-Normal", fillcolor="#E8F5EE", color="#1FA971"];
  test [label="Locked test set: 132 graduates,\nevaluated once", fillcolor="#FDECEC", color="#C0392B"];
  boot [label="200 bootstrap refits\n(uncertainty)"];
  app [label="Runtime service: prediction,\nexplanation and what-if"];
  tr -> pre; pre -> m1; pre -> m2; pre -> m3; pre -> m4;
  m1 -> curve; m2 -> curve; m3 -> curve; m4 -> curve;
  curve -> val -> rule -> sel; sel -> test; sel -> boot -> app;
  {rank=same; test; boot}
}
